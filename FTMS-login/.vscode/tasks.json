{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Football Tournament Manager",
      "type": "process",
      "command": "C:\\msys64\\ucrt64\\bin\\cmake.exe",
      "args": ["--build", "build"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}" }
      },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Run Football Tournament Manager",
      "type": "process",
      "command": "${workspaceFolder}\\build\\FootballTournamentManager.exe",
      "dependsOn": "Build Football Tournament Manager",
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}" }
      },
      "presentation": { "reveal": "always", "panel": "shared", "focus": true },
      "problemMatcher": []
    }
  ]
}
