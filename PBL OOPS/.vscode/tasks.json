{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure PBL OOPS",
      "type": "process",
      "command": "C:\\msys64\\ucrt64\\bin\\cmake.exe",
      "args": [
        "-S", "${workspaceFolder}",
        "-B", "${workspaceFolder}/build",
        "-G", "Ninja",
        "-DCMAKE_C_COMPILER=C:/msys64/ucrt64/bin/gcc.exe",
        "-DCMAKE_CXX_COMPILER=C:/msys64/ucrt64/bin/g++.exe",
        "-DCMAKE_MAKE_PROGRAM=C:/msys64/ucrt64/bin/ninja.exe",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}" }
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Build PBL OOPS",
      "type": "process",
      "command": "C:\\msys64\\ucrt64\\bin\\cmake.exe",
      "args": ["--build", "${workspaceFolder}/build"],
      "dependsOn": "Configure PBL OOPS",
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}" }
      },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Run PBL OOPS",
      "type": "process",
      "command": "${workspaceFolder}\\build\\neymar.exe",
      "dependsOn": "Build PBL OOPS",
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}" }
      },
      "presentation": { "reveal": "always", "panel": "shared", "focus": true },
      "problemMatcher": []
    }
  ]
}
